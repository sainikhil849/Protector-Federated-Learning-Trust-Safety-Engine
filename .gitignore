# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files and local secrets
.env
.env.*
*.local

# Logs and temp files
*.log
logs/
tmp/
temp/
*.tmp

# IDE/editor files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated runtime outputs
experiments/results/*.csv
experiments/results/*.json
real_data_results.csv
real_data_results.json
scenario_results.csv
scenario_results.json
validation_results.csv
validation_results.json

# Keep real test fixtures tracked
!tests/fixtures/
!tests/fixtures/*.csv
